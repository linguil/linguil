{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "linguil",
  "media": {
    "dir": "src/client/public"
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "regular"
      },
      "game": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 5 * * *"
      }
    }
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_POST"
      ]
    },
    "http": {
      "enable": true,
      "domains": [
        "us-central1-linguil.cloudfunctions.net",
        "storage.googleapis.com"
      ]
    },
    "redis": true,
    "payments": true,
    "journeys": true
  },
  "payments": {
    "$schema": "https://developers.reddit.com/schema/products.json",
    "products": [
      {
        "sku": "linguil_plus",
        "displayName": "linguil+",
        "description": "Unlock unlimited, offline games | Thanks for supporting linguil ʕっ•ᴥ•ʔっ♡",
        "price": 100,
        "images": {
          "icon": "icon-1024x1024.png"
        },
        "accountingType": "DURABLE"
      }
    ],
    "endpoints": {
      "fulfillOrder": "/internal/payments/fulfill",
      "refundOrder": "/internal/payments/refund"
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create linguil post",
        "location": "subreddit",
        "endpoint": "/internal/menu/create-post",
        "forUserType": "user"
      }
    ]
  },
  "marketingAssets": {
    "icon": "src/client/public/icon-1024x1024.png"
  },
  "dev": {
    "subreddit": "linguil"
  },
  "settings": {
    "global": {
      "NEXT_PUBLIC_FIREBASE_EMAIL_AUTH_FUNCTION_URL": {
        "type": "string",
        "label": "NEXT_PUBLIC_FIREBASE_EMAIL_AUTH_FUNCTION_URL",
        "defaultValue": "https://us-central1-linguil.cloudfunctions.net/authProxy"
      },
      "NEXT_PUBLIC_FIREBASE_REDDIT_AUTH_FUNCTION_URL": {
        "type": "string",
        "label": "NEXT_PUBLIC_FIREBASE_REDDIT_AUTH_FUNCTION_URL",
        "defaultValue": "https://us-central1-linguil.cloudfunctions.net/redditAuth"
      },
      "NEXT_PUBLIC_FIREBASE_REDDIT_GOLD_WEBHOOK_URL": {
        "type": "string",
        "label": "NEXT_PUBLIC_FIREBASE_REDDIT_GOLD_WEBHOOK_URL",
        "defaultValue": "https://us-central1-linguil.cloudfunctions.net/redditGoldWebhook"
      },
      "NEXT_PUBLIC_FIREBASE_API_KEY": {
        "type": "string",
        "label": "NEXT_PUBLIC_FIREBASE_API_KEY",
        "isSecret": true
      },
      "NEXT_PUBLIC_FIREBASE_PROJECT_ID": {
        "type": "string",
        "label": "NEXT_PUBLIC_FIREBASE_PROJECT_ID",
        "defaultValue": "linguil"
      },
      "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": {
        "type": "string",
        "label": "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET",
        "defaultValue": "linguil.firebasestorage.app"
      },
      "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID": {
        "type": "string",
        "label": "NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID",
        "defaultValue": "G-DD4VPW4P34"
      },
      "NEXT_PUBLIC_DISCORD_CLIENT_ID": {
        "type": "string",
        "label": "NEXT_PUBLIC_DISCORD_CLIENT_ID",
        "defaultValue": "1473406949792940247"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch --mode client & vite build --watch --mode server",
    "build": "vite build --mode client && vite build --mode server"
  }
}