{
  "firestore": {
    "database": "(default)",
    "location": "us-central1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "node scripts/sync-data.js",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        ".gitignore",
        "firebase-debug*.log",
        "*.log",
        "src/**",
        "tsconfig.json",
        "eslint.config.js",
        ".runtimeconfig.json"
      ]
    },
    {
      "kit": "firestore-bigquery-export",
      "sourcePackage": {
        "name": "@firebase-function-kits/firestore-bigquery-export"
      },
      "source": "function-kits/firestore-bigquery-export/source",
      "instances": {
        "firestore-bigquery-export": "function-kits/firestore-bigquery-export/config-firestore-bigquery-export",
        "firestore-bigquery-export-bvme": "function-kits/firestore-bigquery-export/config-firestore-bigquery-export-bvme",
        "firestore-bigquery-export-soyr": "function-kits/firestore-bigquery-export/config-firestore-bigquery-export-soyr"
      },
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules",
    "bucket": "linguil.firebasestorage.app"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "apphosting.yaml"
    ]
  },
  "apphosting": {
    "backendId": "studio",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ],
    "alwaysDeployFromSource": true
  }
}